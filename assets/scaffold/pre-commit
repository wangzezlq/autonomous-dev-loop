#!/usr/bin/env bash
# Autonomous-dev-loop gate: refuse a commit if the test suite is red, so "green = gate"
# is enforced by the system instead of trusted to goodwill.
#
# Install (from your repo root):
#   cp <this-file> .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or, to keep it in version control and share it:
#   mkdir -p .githooks && cp <this-file> .githooks/pre-commit && chmod +x .githooks/pre-commit
#   git config core.hooksPath .githooks
#
# Override for a single commit (use sparingly): git commit --no-verify
set -uo pipefail

# --- configure this for your project: the command that exits 0 on green ---
TEST_CMD="${TEST_CMD:-make test}"
# Examples:
#   pytest -q
#   npm test --silent
#   go test ./...
#   cargo test
#   swift run CoreTests
# --------------------------------------------------------------------------

echo "▶︎ pre-commit: running tests ($TEST_CMD)…"
if eval "$TEST_CMD"; then
    echo "✅ green — allowing commit"
    exit 0
else
    echo "❌ tests failed — commit blocked."
    echo "   Fix to green, or override with: git commit --no-verify"
    exit 1
fi
